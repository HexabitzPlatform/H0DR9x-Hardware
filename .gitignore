# -------------------------------------------------------------------------
# Altium Designer Project Ignores
# These files are build artifacts, temporary files, or local user settings.
# -------------------------------------------------------------------------

# 1. Project-Specific Outputs and History
# Ignore history files that record local changes
*.~*
# Ignore auto-saved and backup files
*.~(Prj|Pcb|Sch|Lib)Bak
# Ignore project backup directory
Project Outputs for */

# 2. PCB, Schematic, and Output Files
# Ignore compiled/generated files (e.g., Gerbers, Assembly, BOMs)
History/
Outputs/
PDF/

# 3. PCB Lock and Local Configuration
# Ignore lock files (used when the file is open)
*.PcbLib-lck
*.PcbDoc-lck
*.SchLib-lck
*.SchDoc-lck

# Ignore project-specific local settings (user and system)
*.PrjPcb-lck
*.PrjPcb-sys
*.PrjPcb-usr
*.PcbDoc-sys
*.PcbDoc-usr
*.SchDoc-sys
*.SchDoc-usr

# 4. Workspace and Vault Files
# Ignore workspace-related files
*.DsnWrk
*.PrjScr

# 5. Simulation Files
# Ignore simulation output folders/files
Sim/
*.sdf
*.wnd

# 6. General OS/Editor Files
# Ignore Mac OS temporary files
.DS_Store

# Ignore Windows Thumbs.db
Thumbs.db